# =====================================================================
# Gadget Wallet — Environment Variables
# Copy to `.env` for local dev; add the same keys in Vercel → Settings →
# Environment Variables for production. Every var below is SERVER-ONLY
# (used by the Hono API / build tooling) — none are exposed to the browser.
# The frontend ships NO secrets: it calls the same-origin `/api`, so there
# is deliberately no client-side env var (no VITE_API_URL / NEXT_PUBLIC_*).
# =====================================================================

# ─── Database (Neon PostgreSQL) ──────────────────────────  [server-only]
# All product data, orders, users, carts and image metadata live here.
# PRODUCTION: use Neon's *pooled* connection string (host ends in `-pooler`).
# The driver sets prepare:false so this pooled/PgBouncer endpoint works.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Image Storage (Supabase Storage) ────────────────────  [server-only]
# Product images upload to the public "products" bucket under
# products/{productId}/{file}. The SERVICE ROLE key is SERVER-ONLY — never
# expose it in the frontend or commit it to git.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NOTE: SUPABASE_ANON_KEY is intentionally NOT used — all uploads go through
# the server with the service-role key. Do not add the anon key to the client.

# ─── Auth ────────────────────────────────────────────────  [server-only]
# JWT signing secret (generate with: openssl rand -hex 32).
# MUST be identical across Production/Preview or issued tokens stop verifying.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ─── CORS / App origin ───────────────────────────────────  [server-only]
# The deployed frontend URL. Same-origin /api needs no CORS; this only gates
# cross-origin access. Comma-separate multiple origins (prod + preview).
APP_URL=https://your-app.vercel.app

# ─── Runtime (optional) ──────────────────────────────────  [server-only]
# Vercel sets NODE_ENV automatically and ignores PORT (requests go to the
# serverless function), so both are local/standalone concerns only.
# API_PORT is what apps/server reads first; keep it 3000 to match the Vite
# dev proxy in apps/web/vite.config.ts. It is separate from PORT because Vite
# also reads PORT — sharing one variable would point both at the same port.
# API_PORT=3000
# NODE_ENV=production   # set to "production" to enforce Supabase (no local-disk fallback)

# ─── Email (optional, reserved) ──────────────────────────  [server-only]
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
