# ─── Database (Neon PostgreSQL) ──────────────────────────────────────
# All product data, orders, users, carts and image metadata live here.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Image Storage (Supabase Storage) ────────────────────────────────
# Product images are uploaded to the public "products" bucket and stored under
# products/{productId}/{file}. The service role key is SERVER-ONLY — never
# expose it in the frontend or commit it to git.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────
# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS origin — the deployed frontend URL (e.g. https://your-app.vercel.app)
APP_URL=http://localhost:5173

# Server port (Vercel/Railway set this automatically)
PORT=3000

# ─── Email (optional, reserved) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional — set to "production" to enforce Supabase Storage (no local-disk fallback)
# NODE_ENV=production
