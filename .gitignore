node_modules/
dist/
build/
*.log
.DS_Store
.vite/

# TypeScript incremental build state. These must NOT be committed: `tsc -b`
# trusts a stale tsbuildinfo and skips recompiling, so CI can "succeed" without
# ever typechecking the changed files (dist/ is ignored, so the outputs it
# claims to have already emitted aren't even present).
*.tsbuildinfo

# Vercel
.vercel/

# Local dev uploads (production uses Supabase Storage)
apps/server/uploads/
uploads/

# Environment files — ignore all real secrets, but KEEP the committed template.
.env
.env.*
!.env.example
