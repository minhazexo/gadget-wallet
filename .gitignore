node_modules/
dist/
build/
*.log
.DS_Store
.vite/

# TypeScript incremental build state. These must NOT be committed: `tsc -b`
# trusts a stale tsbuildinfo and skips recompiling, so CI can "succeed" without
# ever typechecking the changed files (dist/ is ignored, so the outputs it
# claims to have already emitted aren't even present).
*.tsbuildinfo

# Turbo task cache (generated build metadata)
.turbo/

# AI knowledge-graph output (generated by the graphify skill)
graphify-out/

# Vercel CLI local state
.vercel/

# Local dev uploads (production uses Supabase Storage)
apps/server/uploads/
uploads/

# Environment files — ignore all real secrets, but KEEP the committed template.
.env
.env.*
!.env.example

# Local credentials / personal notes — never push to GitHub
login details/

# Unused design/reference assets (not referenced by the app; real brand logos
# are generated + stored in Supabase)
icons and logo/

# Reference screenshots dropped into client/public (not used by the app)
client/public/ChatGPT Image Aug 11, 2026, 02_30_54 AM.png
client/public/image_f13cde9c.png

# ── Not needed for Vercel hosting ──
# Product data (images, prices, specs) lives in Neon + Supabase, so the local
# mirrors and one-off dev tools are not part of the deployed app.

# Dev/ops scripts: image fetch/upload, DB migrate/seed, smoke tests. CI only
# runs typecheck + build (none include scripts/); vercel.json builds client/dist.
scripts/

# Local product-photo mirrors used only by scripts (the app serves Supabase URLs).
assets/

# Pre-migration database snapshot (data already migrated into Neon).
backups/

# Local AI skill files (graphify/neon-postgres) — dev-only.
.kilo/
