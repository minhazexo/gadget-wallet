{
  "name": "gadget-wallet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --env-file=.env --parallel dev:web dev:server",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/server build",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "bun run --cwd apps/server build",
    "db:generate": "bun run --cwd packages/db generate",
    "db:push": "bun run --env-file=../../.env --cwd packages/db push",
    "db:push:vercel": "npm run --prefix packages/db push",
    "db:seed": "bun run --env-file=../../.env --cwd packages/db seed",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/server typecheck"
  },
  "dependencies": {
    "drizzle-orm": "0.36.3",
    "hono": "^4.5.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "overrides": {
    "drizzle-orm": "0.36.3"
  }
}